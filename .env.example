# ==============================================================================
# CONDIGENCE LLP - AI AGENTIC OPERATIONS SYSTEM ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION SETTINGS
# ------------------------------------------------------------------------------
APP_NAME="Condigence AI Operations System"
ENVIRONMENT=development                # 'development' | 'staging' | 'production'
DEBUG=True                             # True for verbose logging and live reload
HOST=0.0.0.0
PORT=8000
SECRET_KEY=condigence_super_secret_dev_key_2026_change_in_prod
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# 2. LLM & OBSERVABILITY (Required for Live AI Decisions)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here               # Required for GPT-4o agent reasoning
OPENAI_MODEL=gpt-4o
LANGSMITH_TRACING=true                                # Set to true to track traces in LangSmith
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_api_key_here         # Optional for real-time observability & cost audits
LANGSMITH_PROJECT=condigence-agentic-ops

# ------------------------------------------------------------------------------
# 3. DATABASES & PERSISTENCE
# ------------------------------------------------------------------------------
MONGODB_URI=mongodb://localhost:27017                 # MongoDB Atlas / local connection URI
MONGODB_DB_NAME=condigence_ops

# ------------------------------------------------------------------------------
# 4. CACHING & DISTRIBUTED LOCKS (Redis)
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# 5. EVENT STREAMING & MESSAGE QUEUE (Apache Kafka)
# ------------------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092                # Complements Redis for persistent distributed event logs
KAFKA_ENABLE=True
KAFKA_TOPIC_AGENT_TASKS=condigence.agent.tasks
KAFKA_TOPIC_AUDIT_LOGS=condigence.audit.logs
KAFKA_TOPIC_APPROVALS=condigence.approvals

# ------------------------------------------------------------------------------
# 6. VECTOR DATABASE & SOP RAG (Pinecone)
# ------------------------------------------------------------------------------
PINECONE_API_KEY=your_pinecone_api_key_here           # For company policy / MCA checklist vector search
PINECONE_ENVIRONMENT=us-east-1
PINECONE_INDEX_NAME=condigence-sop-index

# ------------------------------------------------------------------------------
# 7. BUSINESS SYSTEM INTEGRATIONS (Zoho Books & Zoho CRM)
# ------------------------------------------------------------------------------
ZOHO_CLIENT_ID=your_zoho_client_id                    # For drafting invoices & CRM client sync
ZOHO_CLIENT_SECRET=your_zoho_client_secret
ZOHO_REFRESH_TOKEN=your_zoho_refresh_token
ZOHO_ORG_ID=your_zoho_org_id

# ------------------------------------------------------------------------------
# 8. PROJECT MANAGEMENT INTEGRATION (Notion)
# ------------------------------------------------------------------------------
NOTION_API_KEY=your_notion_integration_token          # For project agent task boards & SOP sync
NOTION_TASK_DB_ID=your_notion_tasks_database_id

# ------------------------------------------------------------------------------
# 9. CLIENT COMMUNICATION (Gmail API & WhatsApp Cloud API)
# ------------------------------------------------------------------------------
GMAIL_CREDENTIALS_JSON_PATH=credentials.json          # OAuth2 client credentials JSON file for Gmail API
WHATSAPP_API_TOKEN=your_whatsapp_business_api_token   # Meta WhatsApp Business Cloud API access token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id

# ------------------------------------------------------------------------------
# 10. WORKFLOW AUTOMATION (n8n Engine)
# ------------------------------------------------------------------------------
N8N_WEBHOOK_URL=http://localhost:5678/webhook/        # Webhook URL for scheduled reminders & cron triggers
